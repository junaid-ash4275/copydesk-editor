{
  "framework": null,
  "buildCommand": "npm run build && npm run db:demo -w server && cp server/prisma/demo.db api/demo.db",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/api/:path(.*)", "destination": "/api?__original=/api/:path" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 10,
      "includeFiles": "{api/demo.db,server/prisma/demo.db,server/prisma/schema.prisma,server/dist/**,node_modules/.prisma/**,node_modules/@prisma/**}"
    }
  }
}
